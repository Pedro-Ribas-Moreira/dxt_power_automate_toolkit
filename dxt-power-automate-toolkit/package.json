{
  "name": "dxt-power-automate-toolkit",
  "displayName": "DXT Power Automate Toolkit",
  "description": "Local development toolkit for Power Automate solutions",
  "version": "0.3.0",
  "publisher": "prepaypower-dta",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dxt-power-automate",
          "title": "Power Automate Toolkit",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "dxt-power-automate": [
        {
          "id": "dxt-power-automate.treeView",
          "name": "Environments",
          "icon": "resources/icon.svg"
        },
        {
          "id": "dxt-power-automate.libraryView",
          "name": "Action Library",
          "icon": "resources/icon.svg"
        },
        {
          "id": "dxt-power-automate.asanaView",
          "name": "Asana Tasks",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "dxt-power-automate.asanaView",
        "contents": "Connect Asana to see your Digital Transformation tasks.\n[Set Asana Personal Access Token](command:dxt-power-automate-toolkit.asanaSetPat)\nCreate a token at [app.asana.com/0/my-apps](https://app.asana.com/0/my-apps).",
        "when": "!dxt-power-automate.asanaConfigured"
      }
    ],
    "commands": [
      {
        "command": "dxt-power-automate-toolkit.refresh",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "Power Automate"
      },
      {
        "command": "dxt-power-automate-toolkit.buildLibrary",
        "title": "Build Library from Local Solutions",
        "icon": "$(refresh)",
        "category": "Power Automate"
      },
      {
        "command": "dxt-power-automate-toolkit.deepScan",
        "title": "Deep Scan — Fetch & Index Solutions",
        "icon": "$(cloud-download)",
        "category": "Power Automate"
      },
      {
        "command": "dxt-power-automate-toolkit.filterLibrary",
        "title": "Search Library",
        "icon": "$(search)",
        "category": "Power Automate"
      },
      {
        "command": "dxt-power-automate-toolkit.copySnippet",
        "title": "Copy Snippet",
        "icon": "$(copy)",
        "category": "Power Automate"
      },
      {
        "command": "dxt-power-automate-toolkit.newSolution",
        "title": "New Solution",
        "icon": "$(add)",
        "category": "Power Automate"
      },
      {
        "command": "dxt-power-automate-toolkit.exportSolution",
        "title": "Pull from Cloud",
        "icon": "$(cloud-download)",
        "category": "Power Automate"
      },
      {
        "command": "dxt-power-automate-toolkit.importSolution",
        "title": "Push to Cloud",
        "icon": "$(cloud-upload)",
        "category": "Power Automate"
      },
      {
        "command": "dxt-power-automate-toolkit.runFlow",
        "title": "Run Flow Locally",
        "icon": "$(play)",
        "category": "Power Automate"
      },
      {
        "command": "dxt-power-automate-toolkit.viewFlow",
        "title": "Visualize Flow",
        "icon": "$(eye)",
        "category": "Power Automate"
      },
      {
        "command": "dxt-power-automate-toolkit.importMockData",
        "title": "Import Mock Data",
        "icon": "$(database)",
        "category": "Power Automate"
      },
      {
        "command": "dxt-power-automate-toolkit.openInBrowser",
        "title": "Open in Browser",
        "icon": "$(link-external)",
        "category": "Power Automate"
      },
      {
        "command": "dxt-power-automate-toolkit.navigateFromUrl",
        "title": "Go to Flow or Solution from URL…",
        "icon": "$(search)",
        "category": "Power Automate"
      },
      {
        "command": "dxt-power-automate-toolkit.generateDocs",
        "title": "Generate Flow Documentation (FLOWS.md)",
        "icon": "$(book)",
        "category": "Power Automate"
      },
      {
        "command": "dxt-power-automate-toolkit.searchFlows",
        "title": "Search Flows…",
        "icon": "$(list-filter)",
        "category": "Power Automate"
      },
      {
        "command": "dxt-power-automate-toolkit.setupContext",
        "title": "Edit Company Knowledge",
        "icon": "$(organization)",
        "category": "Power Automate"
      },
      {
        "command": "dxt-power-automate-toolkit.buildCloudIndex",
        "title": "Build & Share Cloud Index",
        "icon": "$(cloud-upload)",
        "category": "Power Automate"
      },
      {
        "command": "dxt-power-automate-toolkit.pullSharedIndex",
        "title": "Pull Latest Index from SharePoint",
        "icon": "$(cloud-download)",
        "category": "Power Automate"
      },
      {
        "command": "dxt-power-automate-toolkit.discoverSharePoint",
        "title": "Discover SharePoint Sites & Lists",
        "icon": "$(list-tree)",
        "category": "Power Automate"
      },
      {
        "command": "dxt-power-automate-toolkit.viewFlowRuns",
        "title": "View Recent Runs",
        "icon": "$(history)",
        "category": "Power Automate"
      },
      {
        "command": "dxt-power-automate-toolkit.checkDependencies",
        "title": "Check Import Dependencies",
        "icon": "$(debug-disconnect)",
        "category": "Power Automate"
      },
      {
        "command": "dxt-power-automate-toolkit.manageEnvVars",
        "title": "Manage Environment Variables",
        "icon": "$(settings-gear)",
        "category": "Power Automate"
      },
      {
        "command": "dxt-power-automate-toolkit.addToEnvironment",
        "title": "Add Solution to Environment",
        "icon": "$(add)",
        "category": "Power Automate"
      },
      {
        "command": "dxt-power-automate-toolkit.addTemplateFlow",
        "title": "Add Template Flow",
        "icon": "$(file-add)",
        "category": "Power Automate"
      },
      {
        "command": "dxt-power-automate-toolkit.openLibrarySearch",
        "title": "Library Search",
        "icon": "$(search)",
        "category": "Power Automate"
      },
      {
        "command": "dxt-power-automate-toolkit.asanaSetPat",
        "title": "Asana: Set Personal Access Token",
        "icon": "$(key)",
        "category": "Power Automate"
      },
      {
        "command": "dxt-power-automate-toolkit.asanaRefresh",
        "title": "Refresh Asana Tasks",
        "icon": "$(refresh)",
        "category": "Power Automate"
      },
      {
        "command": "dxt-power-automate-toolkit.asanaCreateTask",
        "title": "Asana: New Task",
        "icon": "$(add)",
        "category": "Power Automate"
      },
      {
        "command": "dxt-power-automate-toolkit.asanaOpenTask",
        "title": "Open Asana Task",
        "category": "Power Automate"
      },
      {
        "command": "dxt-power-automate-toolkit.asanaOpenInBrowser",
        "title": "Open in Asana",
        "icon": "$(link-external)",
        "category": "Power Automate"
      },
      {
        "command": "dxt-power-automate-toolkit.asanaAddComment",
        "title": "Add Comment",
        "icon": "$(comment)",
        "category": "Power Automate"
      },
      {
        "command": "dxt-power-automate-toolkit.linkAsanaTask",
        "title": "Link Asana Task…",
        "icon": "$(link)",
        "category": "Power Automate"
      },
      {
        "command": "dxt-power-automate-toolkit.unlinkAsanaTask",
        "title": "Unlink Asana Task",
        "icon": "$(debug-disconnect)",
        "category": "Power Automate"
      },
      {
        "command": "dxt-power-automate-toolkit.asanaImportBridgeLinks",
        "title": "Asana: Import Links from DXT Bridge",
        "category": "Power Automate"
      }
    ],
    "configuration": {
      "title": "DXT Power Automate Toolkit",
      "properties": {
        "dxt-power-automate.pacCliPath": {
          "type": "string",
          "default": "",
          "description": "Full path to pac.exe. Leave empty to auto-detect. Run '(Get-Command pac).Source' in your terminal to find it."
        },
        "dxt-power-automate.errorNotifyEmail": {
          "type": "string",
          "default": "",
          "description": "Email address for the Catch-scope error notification in scaffolded starter flows. Leave empty to use the DT team default."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "dxt-power-automate-toolkit.navigateFromUrl",
          "when": "view == dxt-power-automate.treeView",
          "group": "navigation@1"
        },
        {
          "command": "dxt-power-automate-toolkit.searchFlows",
          "when": "view == dxt-power-automate.treeView",
          "group": "navigation@2"
        },
        {
          "command": "dxt-power-automate-toolkit.setupContext",
          "when": "view == dxt-power-automate.treeView",
          "group": "navigation@3"
        },
        {
          "command": "dxt-power-automate-toolkit.buildCloudIndex",
          "when": "view == dxt-power-automate.treeView",
          "group": "navigation@4"
        },
        {
          "command": "dxt-power-automate-toolkit.pullSharedIndex",
          "when": "view == dxt-power-automate.treeView",
          "group": "navigation@5"
        },
        {
          "command": "dxt-power-automate-toolkit.discoverSharePoint",
          "when": "view == dxt-power-automate.treeView",
          "group": "navigation@6"
        },
        {
          "command": "dxt-power-automate-toolkit.openLibrarySearch",
          "when": "view == dxt-power-automate.libraryView",
          "group": "navigation@0"
        },
        {
          "command": "dxt-power-automate-toolkit.filterLibrary",
          "when": "view == dxt-power-automate.libraryView",
          "group": "navigation@1"
        },
        {
          "command": "dxt-power-automate-toolkit.asanaRefresh",
          "when": "view == dxt-power-automate.asanaView",
          "group": "navigation@1"
        },
        {
          "command": "dxt-power-automate-toolkit.asanaCreateTask",
          "when": "view == dxt-power-automate.asanaView",
          "group": "navigation@2"
        },
        {
          "command": "dxt-power-automate-toolkit.deepScan",
          "when": "view == dxt-power-automate.libraryView",
          "group": "navigation@2"
        },
        {
          "command": "dxt-power-automate-toolkit.buildLibrary",
          "when": "view == dxt-power-automate.libraryView",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "dxt-power-automate-toolkit.addToEnvironment",
          "when": "view == dxt-power-automate.treeView && viewItem == environment",
          "group": "inline"
        },
        {
          "command": "dxt-power-automate-toolkit.exportSolution",
          "when": "view == dxt-power-automate.treeView && viewItem == solution",
          "group": "inline"
        },
        {
          "command": "dxt-power-automate-toolkit.generateDocs",
          "when": "view == dxt-power-automate.treeView && viewItem == solution-local",
          "group": "inline@1"
        },
        {
          "command": "dxt-power-automate-toolkit.exportSolution",
          "when": "view == dxt-power-automate.treeView && viewItem == solution-local",
          "group": "inline@2"
        },
        {
          "command": "dxt-power-automate-toolkit.importSolution",
          "when": "view == dxt-power-automate.treeView && viewItem == solution-local",
          "group": "inline@3"
        },
        {
          "command": "dxt-power-automate-toolkit.viewFlowRuns",
          "when": "view == dxt-power-automate.treeView && viewItem == flow",
          "group": "inline@1"
        },
        {
          "command": "dxt-power-automate-toolkit.addTemplateFlow",
          "when": "view == dxt-power-automate.treeView && viewItem == solution-local",
          "group": "1_flow@1"
        },
        {
          "command": "dxt-power-automate-toolkit.checkDependencies",
          "when": "view == dxt-power-automate.treeView && viewItem == solution-local",
          "group": "2_dataverse@1"
        },
        {
          "command": "dxt-power-automate-toolkit.manageEnvVars",
          "when": "view == dxt-power-automate.treeView && viewItem == solution-local",
          "group": "2_dataverse@2"
        },
        {
          "command": "dxt-power-automate-toolkit.viewFlow",
          "when": "view == dxt-power-automate.treeView && viewItem == flow",
          "group": "inline@2"
        },
        {
          "command": "dxt-power-automate-toolkit.importMockData",
          "when": "view == dxt-power-automate.treeView && viewItem == flow",
          "group": "inline@1"
        },
        {
          "command": "dxt-power-automate-toolkit.runFlow",
          "when": "view == dxt-power-automate.treeView && viewItem == flow",
          "group": "inline@3"
        },
        {
          "command": "dxt-power-automate-toolkit.openInBrowser",
          "when": "view == dxt-power-automate.treeView && viewItem == flow",
          "group": "inline@4"
        },
        {
          "command": "dxt-power-automate-toolkit.openInBrowser",
          "when": "view == dxt-power-automate.treeView && viewItem == solution",
          "group": "inline@2"
        },
        {
          "command": "dxt-power-automate-toolkit.openInBrowser",
          "when": "view == dxt-power-automate.treeView && viewItem == solution-local",
          "group": "inline@3"
        },
        {
          "command": "dxt-power-automate-toolkit.copySnippet",
          "when": "view == dxt-power-automate.libraryView && viewItem == operation",
          "group": "inline"
        },
        {
          "command": "dxt-power-automate-toolkit.copySnippet",
          "when": "view == dxt-power-automate.libraryView && viewItem == example",
          "group": "inline"
        },
        {
          "command": "dxt-power-automate-toolkit.copySnippet",
          "when": "view == dxt-power-automate.libraryView && viewItem == botpattern",
          "group": "inline"
        },
        {
          "command": "dxt-power-automate-toolkit.linkAsanaTask",
          "when": "view == dxt-power-automate.treeView && viewItem == solution-local",
          "group": "1_flow@2"
        },
        {
          "command": "dxt-power-automate-toolkit.asanaOpenInBrowser",
          "when": "view == dxt-power-automate.treeView && viewItem == asana-task",
          "group": "inline@1"
        },
        {
          "command": "dxt-power-automate-toolkit.unlinkAsanaTask",
          "when": "view == dxt-power-automate.treeView && viewItem == asana-task",
          "group": "asana@1"
        },
        {
          "command": "dxt-power-automate-toolkit.asanaOpenInBrowser",
          "when": "view == dxt-power-automate.asanaView && viewItem == asana-task",
          "group": "inline@1"
        },
        {
          "command": "dxt-power-automate-toolkit.asanaAddComment",
          "when": "view == dxt-power-automate.asanaView && viewItem == asana-task",
          "group": "asana@1"
        },
        {
          "command": "dxt-power-automate-toolkit.linkAsanaTask",
          "when": "view == dxt-power-automate.asanaView && viewItem == asana-task",
          "group": "asana@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.120.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "webpack": "^5.105.3",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@azure/msal-node": "^5.2.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  }
}
