                  },
                  "variables": {
                    "1": "@item()['Customer First Name']",
                    "2": "@if(\n  contains(string(item()['Tank Volume ']), '%'),\n  item()['Tank Volume '],\n  if(\n    less(float(item()['Tank Volume ']), 1),\n    concat(string(mul(float(item()['Tank Volume ']), 100)), '%'),\n    concat(string(item()['Tank Volume ']), '%')\n  )\n)\n",
