            "Select_-_Create_Customers_List_for_WA_Template": {
              "type": "Select",
              "inputs": {
                "from": "@variables('List of Customers')",
                "select": {
                  "consumerContent": {
                    "wa": "@{if(\r\n  startsWith(item()['Phone'], '353'), \r\n  item()['Phone'],\r\n  concat('353', item()['Phone'])\r\n)}"
                  },
                  "variables": {
                    "1": "@{item()['FirstName']}",
                    "2": "@{item()['TankVolume']}"
                  }
                }
              },
              "runAfter": {
                "Apply_to_each": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "f6be3543-0022-41ec-9f36-a51c62bc88fe"
              }
