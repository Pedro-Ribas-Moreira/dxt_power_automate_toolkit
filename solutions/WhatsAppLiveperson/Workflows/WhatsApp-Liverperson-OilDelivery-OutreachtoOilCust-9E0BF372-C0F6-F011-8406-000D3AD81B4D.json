              "actions": {
                "Run_a_query_against_a_dataset": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "groupid": "c308ec0c-defe-4fef-8ae2-d0eb7d1a3ee0",
                      "datasetid": "931ff45d-aed2-485d-94dd-caedba5195a0",
                      "specification/query": "// DAX Query\nDEFINE\n\tVAR __DS0FilterTable = \n\t\tFILTER(\n\t\t\tKEEPFILTERS(VALUES('Customers Address'[CustomerID])),\n\t\t\t'Customers Address'[CustomerID] = @{items('Apply_to_each')['CRN']}\n\t\t)\n\n\tVAR __DS0Core = \n\t\tCALCULATETABLE(\n\t\t\tSUMMARIZE(\n\t\t\t\t'Customers Address',\n\t\t\t\t'Customers Address'[CustomerID],\n\t\t\t\t'Customers Address'[FullAddress],\n\t\t\t\t'Customers Address'[FirstName],\n\t\t\t\t'Customers Address'[MobileNo],\n\t\t\t\t'Customers Address'[SMSAllowed],\n\t\t\t\t'Customers Address'[CustomerRef]\n\t\t\t),\n\t\t\tKEEPFILTERS(__DS0FilterTable)\n\t\t)\n\nEVALUATE\n\t__DS0Core \n\nORDER BY\n\t'Customers Address'[CustomerID],\n\t'Customers Address'[FullAddress],\n\t'Customers Address'[FirstName],\n\t'Customers Address'[MobileNo],\n\t'Customers Address'[SMSAllowed],\n\t'Customers Address'[CustomerRef]\n",
                      "specification/serializerSettings/includeNulls": false
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_powerbi",
                      "operationId": "ExecuteDatasetQuery",
                      "connectionName": "shared_powerbi-1"
                    }
                  }
                },
                "Parse_JSON_-_Customer_Details": {
                  "type": "ParseJson",
                  "inputs": {
                    "content": "@outputs('Run_a_query_against_a_dataset')?['body/firstTableRows'][0]",
                    "schema": {
                      "type": "object",
                      "properties": {
                        "Customers Address[CustomerID]": {
                          "type": "integer"
                        },
                        "Customers Address[FullAddress]": {
                          "type": "string"
                        },
                        "Customers Address[FirstName]": {
                          "type": "string"
                        },
                        "Customers Address[MobileNo]": {
                          "type": "string"
                        },
                        "Customers Address[SMSAllowed]": {
                          "type": "boolean"
                        },
                        "Customers Address[CustomerRef]": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "runAfter": {
                    "Run_a_query_against_a_dataset": [
                      "Succeeded"
                    ]
                  }
                },
                "_SMS_Allowed_-_Exist_AND_is_TRUE": {
                  "type": "Compose",
                  "inputs": "@if(\r\n  contains(\r\n    outputs('Run_a_query_against_a_dataset')?['body']['firstTableRows'][0],\r\n    'Customers Address[SMSAllowed]'\r\n  ),\r\n  outputs('Run_a_query_against_a_dataset')?['body']['firstTableRows'][0]['Customers Address[SMSAllowed]'],\r\n  false\r\n)\r\n",
                  "runAfter": {
                    "Parse_JSON_-_Customer_Details": [
                      "Succeeded"
                    ]
                  }
                },
                "Condition": {
                  "type": "If",
                  "expression": {
                    "and": [
                      {
                        "equals": [
                          "@outputs('_SMS_Allowed_-_Exist_AND_is_TRUE')",
                          true
                        ]
                      }
                    ]
                  },
                  "actions": {
                    "Append_to_array_variable": {
                      "type": "AppendToArrayVariable",
                      "inputs": {
                        "name": "List of Customers",
                        "value": {
                          "CRN": "@{items('Apply_to_each')['CRN']}",
                          "Phone": "@{items('Apply_to_each')?['Mobile']}",
                          "FirstName": "@{body('Parse_JSON_-_Customer_Details')?['Customers Address[FirstName]']}",
                          "TankVolume": "@{items('Apply_to_each')['5am Morning Volume %']}",
                          "SMSAllowed": "@{body('Parse_JSON_-_Customer_Details')?['Customers Address[SMSAllowed]']}"
                        }
                      }
                    }
                  },
                  "else": {
                    "actions": {
                      "Compose_2": {
                        "type": "Compose",
                        "inputs": "@body('Parse_JSON_-_Customer_Details')"
                      }
                    }
                  },
                  "runAfter": {
                    "_SMS_Allowed_-_Exist_AND_is_TRUE": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "runAfter": {
                "Filter_array_-_Billed_-_No_Restrictions_-_Tank_Volume__20_to_30_percent": [
                  "Succeeded"
                ]
              }
            },
            "Compose": {
              "type": "Compose",
              "inputs": "@body('Select_-_Create_Customers_List_for_WA_Template')",
