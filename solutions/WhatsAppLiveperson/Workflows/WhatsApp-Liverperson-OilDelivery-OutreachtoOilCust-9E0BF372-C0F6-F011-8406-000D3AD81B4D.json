            "Filter_array_-_Billed_-_No_Restrictions_-_Tank_Volume__20_to_30_percent": {
              "type": "Query",
              "inputs": {
                "from": "@body('Parse_JSON')",
                "where": "@and(\r\n  equals(item()?['Current Status'], 'Billed'),\r\n  equals(item()?['Fill Restriction Status'], 'No Restriction'),\r\n  greater(int(item()?['5am Morning Volume %']), 30)\r\n)\r\n"
              },
              "runAfter": {
